# Copy to .env and fill in values before running in production.
# Development defaults are shown where applicable.

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames, e.g. myserver.example.com,localhost
ALLOWED_HOSTS=*

# Optional API key for the telemetry ingest endpoint.
# Leave blank to disable authentication (development only).
# Agents must send:  Authorization: Bearer <key>
TELEMETRY_API_KEY=

# PostgreSQL connection string (leave blank to use SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/defendos

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Django superuser (used by: python manage.py setup_admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
